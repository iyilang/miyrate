# micrate's spec/micrate_spec.cr. A plain program: a failed assertion exits
# non-zero, which is what `iyi test` reads.
module miyrate_test

import miyrate/errors::{UnorderedMigrations}
import miyrate/core::{Direction}
import miyrate::{extract_dbversion, migration_plan}

def sample_migrations : Hash(Int64, Bool)
  {
    20160523142308_i64 => true,
    20160523142313_i64 => true,
    20160523142316_i64 => true,
  }
end

assert_eq 0_i64, extract_dbversion([] of Tuple(Int64, Bool)), "dbversion: returns 0 if table is empty"

assert_eq 20160101140000_i64, extract_dbversion([
  {20160101140000_i64, true},
  {20160101130000_i64, true},
  {20160101120000_i64, true},
]), "dbversion: returns last applied migration (rows newest first)"

assert_eq 20160101120000_i64, extract_dbversion([
  {20160101140000_i64, false},
  {20160101140000_i64, true},
  {20160101120000_i64, true},
]), "dbversion: ignores rolled back versions"

assert_eq [20160523142308_i64, 20160523142313_i64, 20160523142316_i64],
  assert_ok { migration_plan(sample_migrations, 0_i64, 20160523142316_i64, Direction::Forward) },
  "up, going forward: runs all migrations if starting from clean db"

assert_eq [20160523142313_i64, 20160523142316_i64],
  assert_ok { migration_plan(sample_migrations, 20160523142308_i64, 20160523142316_i64, Direction::Forward) },
  "up, going forward: skips already performed migrations"

assert_eq [20160523142316_i64, 20160523142313_i64],
  assert_ok { migration_plan(sample_migrations, 20160523142316_i64, 20160523142308_i64, Direction::Backwards) },
  "up, going backwards: skips already performed migrations"

unordered = assert_error(UnorderedMigrations, "fails if there are unapplied migrations with older timestamp than current version") do
  migration_plan({
    20160523142308_i64 => false,
    20160523142313_i64 => true,
    20160523142316_i64 => false,
  }, 20160523142313_i64, 20160523142316_i64, Direction::Forward)
end
assert_eq [20160523142308_i64], unordered.versions
