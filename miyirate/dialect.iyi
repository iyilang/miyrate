# The SQL each database engine needs for the version table,
# `miyirate_db_version`.
module miyirate/dialect

import std/time::{Time}
import std/uri::{URI}
import db/db/core::{Database, Connection}
import db/db/errors::{DBError}
import db/db/value::{ExecResult}
import miyirate/errors::{MiyirateError}

pub abstract class Dialect
  abstract def create_migrations_table(db : Database) : ExecResult | DBError

  # The newest record for *version*: when it was written and whether it
  # applied the migration. Empty when the migration never ran.
  abstract def migration_status(version : Int64, db : Database) : Array(Tuple(Time, Bool)) | DBError

  abstract def record_migration(version : Int64, is_applied : Bool, db : Connection) : ExecResult | DBError

  # The dialect for the scheme of *connection_url*.
  def self.from_connection_url(connection_url : String) : Dialect | MiyirateError
    uri = URI.parse?(connection_url)
    case uri ? uri.scheme : nil
    when "postgresql", "postgres"
      Postgres.new
    when "mysql"
      Mysql.new
    when "sqlite3"
      Sqlite3.new
    else
      MiyirateError.new("Could not infer SQL dialect from connection url #{connection_url}")
    end
  end
end

pub class Postgres < Dialect
  def create_migrations_table(db : Database) : ExecResult | DBError
    db.exec("CREATE TABLE miyirate_db_version (
              id serial NOT NULL,
              version_id bigint NOT NULL,
              is_applied boolean NOT NULL,
              tstamp timestamp NULL default now(),
              PRIMARY KEY(id)
            );")
  end

  def migration_status(version : Int64, db : Database) : Array(Tuple(Time, Bool)) | DBError
    db.query_all("SELECT tstamp, is_applied FROM miyirate_db_version WHERE version_id=$1 ORDER BY tstamp DESC LIMIT 1", version, as: Tuple(Time, Bool))
  end

  def record_migration(version : Int64, is_applied : Bool, db : Connection) : ExecResult | DBError
    db.exec("INSERT INTO miyirate_db_version (version_id, is_applied) VALUES ($1, $2);", version, is_applied)
  end
end

# MySQL has no iyi driver yet; the dialect is here for the one a program
# registers itself.
pub class Mysql < Dialect
  def create_migrations_table(db : Database) : ExecResult | DBError
    db.exec("CREATE TABLE miyirate_db_version (
              id serial NOT NULL,
              version_id bigint NOT NULL,
              is_applied boolean NOT NULL,
              tstamp timestamp NULL default now(),
              PRIMARY KEY(id)
            );")
  end

  def migration_status(version : Int64, db : Database) : Array(Tuple(Time, Bool)) | DBError
    db.query_all("SELECT tstamp, is_applied FROM miyirate_db_version WHERE version_id=? ORDER BY tstamp DESC LIMIT 1", version, as: Tuple(Time, Bool))
  end

  def record_migration(version : Int64, is_applied : Bool, db : Connection) : ExecResult | DBError
    db.exec("INSERT INTO miyirate_db_version (version_id, is_applied) VALUES (?, ?);", version, is_applied)
  end
end

pub class Sqlite3 < Dialect
  # The timestamp is written by the driver rather than defaulted by SQLite,
  # so the driver reads back the format it wrote.
  def create_migrations_table(db : Database) : ExecResult | DBError
    db.exec("CREATE TABLE miyirate_db_version (
              id INTEGER PRIMARY KEY AUTOINCREMENT,
              version_id INTEGER NOT NULL,
              is_applied INTEGER NOT NULL,
              tstamp TIMESTAMP
          );")
  end

  def migration_status(version : Int64, db : Database) : Array(Tuple(Time, Bool)) | DBError
    db.query_all("SELECT tstamp, is_applied FROM miyirate_db_version WHERE version_id=? ORDER BY tstamp DESC LIMIT 1", version, as: Tuple(Time, Bool))
  end

  def record_migration(version : Int64, is_applied : Bool, db : Connection) : ExecResult | DBError
    db.exec("INSERT INTO miyirate_db_version (version_id, is_applied, tstamp) VALUES (?, ?, ?);", version, is_applied, Time.utc)
  end
end
