# micrate's spec/migration_spec.cr. A plain program: a failed `assert` exits
# non-zero, which is what `iyi test` reads.
module miyirate/migration_test

import miyirate/migration::{Migration, Direction}

def statements(migration : Migration, direction : Direction) : Array(String)
  migration.statements(direction).map(&.strip)
end

# split simple statements
simple = Migration.new(20160101120000_i64, "foo.sql", "\
-- +miyirate Up
CREATE TABLE foo(id INT PRIMARY KEY, name VARCHAR NOT NULL);

-- +miyirate Down
DROP TABLE foo;")

assert statements(simple, Direction::Forward) == [
  "-- +miyirate Up\nCREATE TABLE foo(id INT PRIMARY KEY, name VARCHAR NOT NULL);",
]
assert statements(simple, Direction::Backwards) == [
  "-- +miyirate Down\nDROP TABLE foo;",
]

# splits mixed Up and Down statements
mixed = Migration.new(20160101120000_i64, "foo.sql", "\
-- +miyirate Up
CREATE TABLE foo(id INT PRIMARY KEY, name VARCHAR NOT NULL);

-- +miyirate Down
DROP TABLE foo;

-- +miyirate Up
CREATE TABLE bar(id INT PRIMARY KEY);

-- +miyirate Down
DROP TABLE bar;")

assert statements(mixed, Direction::Forward) == [
  "-- +miyirate Up\nCREATE TABLE foo(id INT PRIMARY KEY, name VARCHAR NOT NULL);",
  "-- +miyirate Up\nCREATE TABLE bar(id INT PRIMARY KEY);",
]
assert statements(mixed, Direction::Backwards) == [
  "-- +miyirate Down\nDROP TABLE foo;",
  "-- +miyirate Down\nDROP TABLE bar;",
]

# splits complex statements with user hints: PL/pgSQL with semicolons of
# its own, inside StatementBegin and StatementEnd
complex = Migration.new(20160101120000_i64, "foo.sql", "\
-- +miyirate Up
-- +miyirate StatementBegin
CREATE OR REPLACE FUNCTION histories_partition_creation( DATE, DATE )
returns void AS $$
DECLARE
  create_query text;
BEGIN
  FOR create_query IN SELECT
      'CREATE TABLE IF NOT EXISTS histories_'
      || TO_CHAR( d, 'YYYY_MM' )
      || ' ( CHECK( created_at >= timestamp '''
      || TO_CHAR( d, 'YYYY-MM-DD 00:00:00' )
      || ''' AND created_at < timestamp '''
      || TO_CHAR( d + INTERVAL '1 month', 'YYYY-MM-DD 00:00:00' )
      || ''' ) ) inherits ( histories );'
    FROM generate_series( $1, $2, '1 month' ) AS d
  LOOP
    EXECUTE create_query;
  END LOOP;  -- LOOP END
END;         -- FUNCTION END
$$
language plpgsql;
-- +miyirate StatementEnd")

ret = statements(complex, Direction::Forward)
assert ret.size == 1
assert ret[0] == complex.source

# allows up and down sections with complex scripts
sections = Migration.new(20160101120000_i64, "foo.sql", "\
-- +miyirate Up
-- +miyirate StatementBegin
foo;
bar;
-- +miyirate StatementEnd

-- +miyirate Down
baz;")

assert statements(sections, Direction::Forward) == [
  "-- +miyirate Up\n-- +miyirate StatementBegin\nfoo;\nbar;\n-- +miyirate StatementEnd",
]
assert statements(sections, Direction::Backwards) == [
  "-- +miyirate Down\nbaz;",
]
