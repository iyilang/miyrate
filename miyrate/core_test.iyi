# micrate's spec/migration_spec.cr. A plain program: a failed assertion exits
# non-zero, which is what `iyi test` reads.
module miyrate/core_test

import miyrate/core::{Migration, Direction}

def statements(migration : Migration, direction : Direction) : Array(String)
  migration.statements(direction).map(&.strip)
end

# split simple statements
simple = Migration.new(20160101120000_i64, "foo.sql", "\
-- +miyrate Up
CREATE TABLE foo(id INT PRIMARY KEY, name VARCHAR NOT NULL);

-- +miyrate Down
DROP TABLE foo;")

assert_eq [
  "-- +miyrate Up\nCREATE TABLE foo(id INT PRIMARY KEY, name VARCHAR NOT NULL);",
], statements(simple, Direction::Forward)
assert_eq [
  "-- +miyrate Down\nDROP TABLE foo;",
], statements(simple, Direction::Backwards)

# splits mixed Up and Down statements
mixed = Migration.new(20160101120000_i64, "foo.sql", "\
-- +miyrate Up
CREATE TABLE foo(id INT PRIMARY KEY, name VARCHAR NOT NULL);

-- +miyrate Down
DROP TABLE foo;

-- +miyrate Up
CREATE TABLE bar(id INT PRIMARY KEY);

-- +miyrate Down
DROP TABLE bar;")

assert_eq [
  "-- +miyrate Up\nCREATE TABLE foo(id INT PRIMARY KEY, name VARCHAR NOT NULL);",
  "-- +miyrate Up\nCREATE TABLE bar(id INT PRIMARY KEY);",
], statements(mixed, Direction::Forward)
assert_eq [
  "-- +miyrate Down\nDROP TABLE foo;",
  "-- +miyrate Down\nDROP TABLE bar;",
], statements(mixed, Direction::Backwards)

# splits complex statements with user hints: PL/pgSQL with semicolons of
# its own, inside StatementBegin and StatementEnd
complex = Migration.new(20160101120000_i64, "foo.sql", "\
-- +miyrate Up
-- +miyrate StatementBegin
CREATE OR REPLACE FUNCTION histories_partition_creation( DATE, DATE )
returns void AS $$
DECLARE
  create_query text;
BEGIN
  FOR create_query IN SELECT
      'CREATE TABLE IF NOT EXISTS histories_'
      || TO_CHAR( d, 'YYYY_MM' )
      || ' ( CHECK( created_at >= timestamp '''
      || TO_CHAR( d, 'YYYY-MM-DD 00:00:00' )
      || ''' AND created_at < timestamp '''
      || TO_CHAR( d + INTERVAL '1 month', 'YYYY-MM-DD 00:00:00' )
      || ''' ) ) inherits ( histories );'
    FROM generate_series( $1, $2, '1 month' ) AS d
  LOOP
    EXECUTE create_query;
  END LOOP;  -- LOOP END
END;         -- FUNCTION END
$$
language plpgsql;
-- +miyrate StatementEnd")

assert_eq [complex.source], statements(complex, Direction::Forward)

# allows up and down sections with complex scripts
sections = Migration.new(20160101120000_i64, "foo.sql", "\
-- +miyrate Up
-- +miyrate StatementBegin
foo;
bar;
-- +miyrate StatementEnd

-- +miyrate Down
baz;")

assert_eq [
  "-- +miyrate Up\n-- +miyrate StatementBegin\nfoo;\nbar;\n-- +miyrate StatementEnd",
], statements(sections, Direction::Forward)
assert_eq [
  "-- +miyrate Down\nbaz;",
], statements(sections, Direction::Backwards)
